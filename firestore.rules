rules_version = '2';

// SenteFlow AI — Firestore Security Rules v5
// Each organization's data is isolated: authenticated members can only
// read/write their own org's collections.
//
// Collections covered:
//   transactions, events, customers, conversations, memory,
//   orders, reminders, promises, alerts, audit_logs, profile

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow write: if isMember(orgId);

      // ── Transactions (legacy) ─────────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasAll(['amount', 'currency', 'type', 'category', 'description', 'status', 'org_id'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status in ['pending', 'approved', 'rejected'];

        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'approved_by', 'approved_at', 'upload_session_id']);

        allow delete: if false;
      }

      // ── Business Events ───────────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId)
          && request.resource.data.keys().hasAll(['event_type', 'sender_id', 'raw_message'])
          && request.resource.data.event_id is string;
        // Events are immutable once written — only status/processing_status may update
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['processing_status', 'transaction_id', 'recommended_actions']);
        allow delete: if false;
      }

      // ── Customers ─────────────────────────────────────────────────────────
      match /customers/{customerId} {
        allow read: if isMember(orgId);
        allow write: if isMember(orgId);
        allow delete: if false;
      }

      // ── Conversations ─────────────────────────────────────────────────────
      match /conversations/{conversationId} {
        allow read: if isMember(orgId);
        allow write: if isMember(orgId);

        match /timeline/{entryId} {
          allow read: if isMember(orgId);
          allow create: if isMember(orgId);
          allow update, delete: if false;  // Timeline is append-only
        }
      }

      // ── Customer Memory ───────────────────────────────────────────────────
      match /memory/{customerId} {
        allow read: if isMember(orgId);
        allow write: if isMember(orgId);
        allow delete: if false;
      }

      // ── Orders ────────────────────────────────────────────────────────────
      match /orders/{orderId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId)
          && request.resource.data.keys().hasAll(['customer_id', 'status']);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'payment_status', 'delivery_status', 'timeline', 'items', 'amount', 'notes']);
        allow delete: if false;
      }

      // ── Reminders ─────────────────────────────────────────────────────────
      match /reminders/{reminderId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'sent_at', 'ack_at']);
        allow delete: if false;
      }

      // ── Payment Promises ──────────────────────────────────────────────────
      match /promises/{promiseId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolved_at', 'resolved_by']);
        allow delete: if false;
      }

      // ── Alerts ────────────────────────────────────────────────────────────
      match /alerts/{alertId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acknowledged_at', 'acknowledged_by']);
        allow delete: if false;
      }

      // ── Business Profile ──────────────────────────────────────────────────
      match /profile/{docId} {
        allow read: if isMember(orgId);
        allow write: if isMember(orgId);
      }

      // ── Audit Logs (immutable) ────────────────────────────────────────────
      match /audit_logs/{logId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update, delete: if false;
      }

      // ── Members (for the isMember check above) ────────────────────────────
      match /members/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isMember(orgId));
        allow write: if isMember(orgId);
      }
    }
  }
}
