rules_version = '2';

// SenteFlow AI — Firestore Security Rules v7
// Each organization's data is isolated: authenticated members can only
// read/write their own org's collections. The backend uses the Admin SDK,
// which bypasses these rules; they govern direct access from the dashboard.
//
// NOTE on `allow write`: in Firestore rules `write` = create + update + delete,
// and access is granted if ANY matching rule allows it. So
//     allow write: if isMember(orgId);
//     allow delete: if false;
// still lets members delete. Collections that must not be deletable therefore
// grant `create, update` explicitly instead of `write`.
//
// Collections covered:
//   transactions, events, customers, conversations (+ interactions),
//   memory, orders, reminders, promises, alerts, audit_logs, profile,
//   meta, phone_index (server-only), webhook_queue (server-only)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // ── WhatsApp number → business index (server-only) ───────────────────────
    // Managed through the backend's /api/org/phones endpoints.
    match /phone_index/{phone} {
      allow read, write: if false;
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow update: if isMember(orgId);
      allow create, delete: if false;

      // ── Transactions (legacy) ─────────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read: if isMember(orgId);

        allow create: if isMember(orgId)
          && request.resource.data.keys().hasAll(['amount', 'currency', 'type', 'category', 'description', 'status', 'org_id'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status in ['pending', 'approved', 'rejected'];

        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'approved_by', 'approved_at', 'upload_session_id']);

        allow delete: if false;
      }

      // ── Business Events ───────────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId)
          && request.resource.data.keys().hasAll(['event_type', 'sender_id', 'raw_message'])
          && request.resource.data.event_id is string;
        // Events are immutable once written — only status/processing_status may update
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['processing_status', 'transaction_id', 'recommended_actions']);
        allow delete: if false;
      }

      // ── Customers ─────────────────────────────────────────────────────────
      match /customers/{customerId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Conversations ─────────────────────────────────────────────────────
      // The conversation timeline is an array written only by the backend
      // (Admin SDK). Clients may not touch it at all: a size check alone let
      // a client rewrite every past entry, or drop the field entirely.
      match /conversations/{conversationId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId) && !('timeline' in request.resource.data);
        allow update: if isMember(orgId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['timeline']);
        allow delete: if false;

        // Owner ↔ SenteFlow message log: append-only from the backend.
        match /interactions/{interactionId} {
          allow read: if isMember(orgId);
          allow write: if false;
        }
      }

      // ── Conversation Aggregates (state machine snapshots) ─────────────────
      match /conversation_aggregates/{aggregateId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Customer Profiles (rich CustomerProfile model) ────────────────────
      match /customer_profiles/{profileId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Media Assets (receipts, voice notes) ──────────────────────────────
      match /media_assets/{assetId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Entity Links (why two records belong together) ────────────────────
      match /entity_links/{linkId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update, delete: if false;   // Links are immutable evidence
      }

      // ── Tasks ─────────────────────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Webhook Queue (server-only) ───────────────────────────────────────
      // Written exclusively by the Admin SDK, which bypasses these rules.
      // Denying all client access keeps raw provider payloads out of reach.
      match /webhook_queue/{queueId} {
        allow read, write: if false;
      }

      // ── Customer Memory ───────────────────────────────────────────────────
      match /memory/{customerId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Orders ────────────────────────────────────────────────────────────
      match /orders/{orderId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId)
          && request.resource.data.keys().hasAll(['customer_id', 'status']);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'payment_status', 'delivery_status', 'timeline', 'items', 'amount', 'notes']);
        allow delete: if false;
      }

      // ── Reminders ─────────────────────────────────────────────────────────
      match /reminders/{reminderId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'sent_at', 'ack_at']);
        allow delete: if false;
      }

      // ── Payment Promises ──────────────────────────────────────────────────
      match /promises/{promiseId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'resolved_at', 'resolved_by']);
        allow delete: if false;
      }

      // ── Alerts ────────────────────────────────────────────────────────────
      match /alerts/{alertId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acknowledged_at', 'acknowledged_by']);
        allow delete: if false;
      }

      // ── Business Profile ──────────────────────────────────────────────────
      match /profile/{docId} {
        allow read: if isMember(orgId);
        allow create, update: if isMember(orgId);
        allow delete: if false;
      }

      // ── Server bookkeeping (e.g. daily briefing markers) ──────────────────
      match /meta/{docId} {
        allow read: if isMember(orgId);
        allow write: if false;
      }

      // ── Audit Logs (immutable) ────────────────────────────────────────────
      match /audit_logs/{logId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update, delete: if false;
      }

      // ── Members (for the isMember check above) ────────────────────────────
      match /members/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isMember(orgId));
        allow write: if isMember(orgId);
      }
    }
  }
}
