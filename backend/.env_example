# ── SenteFlow AI — environment template ───────────────────────────────────────
# Copy this file to `.env` (in the same directory) and fill in real values.
# Every variable listed here is read by either the backend or docker-compose.yml.

# ── Primary LLM (required) ────────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Leave the model lines blank to use the current defaults
# (text: openai/gpt-oss-120b, vision: qwen/qwen3.8-27b, speech: whisper-large-v3).
# Groq retired llama-3.3-70b-versatile and the llama vision models in 2025–26;
# if you set a retired model here SenteFlow logs a warning and uses the default.
GROQ_MODEL=
GROQ_VISION_MODEL=
GROQ_WHISPER_MODEL=

# ── Optional fallback LLM providers ───────────────────────────────────────────
# If Groq is rate-limited, SenteFlow silently falls back to these. Leave blank
# to disable fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Ugandan & African languages (strongly recommended) ────────────────────────
# Sunbird AI — Luganda, Runyankole, Acholi, Ateso, Lusoga, Swahili and more.
# Used to (1) detect the language of each message, (2) translate it to
# English before the AI reads it (the AI sees both), (3) transcribe voice
# notes in the business's language, and (4) translate replies when the owner
# picks "reply in the language I write in" in Settings.
# Get a token: create an account at https://api.sunbird.ai (POST /auth/register),
# then POST /auth/token with your email + password → access_token.
# If left blank, nothing is translated and voice notes use Deepgram/Whisper.
SUNBIRD_API_KEY=
# SUNBIRD_API_URL=https://api.sunbird.ai
# SUNBIRD_TIMEOUT=30

# ── Voice note pipeline (recommended) ─────────────────────────────────────────
# Deepgram — STT for English voice notes (and the fallback when Sunbird is
# not configured or fails). Better than Whisper, adds punctuation. Get a key at https://console.deepgram.com/
# If left blank, SenteFlow falls back to Groq Whisper (lower accuracy).
DEEPGRAM_API_KEY=

# ElevenLabs — TTS for voice note replies. When the customer sends a voice
# note, the bot replies with a synthesized voice note. Get a key at
# https://elevenlabs.io/app/settings/api-keys
# If left blank, voice replies fall back to plain text.
ELEVENLABS_API_KEY=
# Voice name (e.g. Rachel, Adam, Bella) or voice ID from your ElevenLabs account
ELEVENLABS_VOICE=Rachel
ELEVENLABS_MODEL=eleven_turbo_v2

# ── Firebase / Firestore (required for backend) ───────────────────────────────
# Path (relative to backend/) to a Firebase service-account JSON. Download
# from Firebase Console → Project Settings → Service Accounts → Generate key.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
DEFAULT_ORG_ID=demo-org

# ── Evolution API (WhatsApp bridge) ───────────────────────────────────────────
# (EVOLUTION_BASE_URL / EVOLUTION_API_KEY / EVOLUTION_SESSION are accepted as
# aliases for the three names below.)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_TOKEN=changeme
EVOLUTION_INSTANCE_NAME=senteflow
# Optional: verify webhooks with an HMAC signature instead of the API key
WEBHOOK_SECRET=

# ── Who may use SenteFlow on WhatsApp ─────────────────────────────────────────
# Only linked numbers can talk to SenteFlow. For the default business, list the
# owner/staff numbers here (comma-separated, international format). Other
# businesses link their numbers from the dashboard (/api/org/phones).
OWNER_PHONES=
DEFAULT_COUNTRY_CODE=256

# ── Error tracking (optional) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Runtime ───────────────────────────────────────────────────────────────────
# production (default) enforces auth and webhook verification.
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=20

# ── Optional business defaults ────────────────────────────────────────────────
# Also treated as an owner number (kept for older setups; prefer OWNER_PHONES)
DEFAULT_OWNER_PHONE=
# Morning briefing: local hour (0-23) in BUSINESS_TZ
BUSINESS_TZ=Africa/Kampala
BRIEFING_HOUR=7
